max_bytes = 50000000
include = ["src/**", "tests/**", "Cargo.toml", "package.json"]
exclude = ["node_modules/**", "target/**", "dist/**"]

[oracle]
provider = "auto"
model = "auto"
history_limit = 8
max_tokens = 8192
temperature = 0.2
timeout_seconds = 180

[loop]
apply_command = ""
repull_command = ""
rebundle_command = ""
max_iterations = 50
convergence_k = 3

[ui]
