```bash
$ assay verify examples/duration/duration.assay --bundle examples/duration/bundle.xml
{
  "assay_version": "2.0.0",
  "spec": { "name": "duration", ... },
  "summary": {
    "total": 7,
    "passed": 0,
    "failed": 6,
